# Plantilla de variables de entorno para Monitoreo Cloud.
# Copia este archivo como `.env` (NO versionado) en la EC2, junto al docker-compose.yml.
# NUNCA pongas valores reales en este archivo de ejemplo ni lo subas al repo.

# --- n8n: autenticación básica de la UI ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambia-esta-contrasena-fuerte

# --- n8n: host público (IP o dominio de la EC2) ---
N8N_HOST=TU_IP_PUBLICA_EC2

# --- n8n: clave de cifrado de credenciales (genera una aleatoria de 32+ chars) ---
# Ejemplo para generarla:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=genera-una-clave-aleatoria

# --- Base de datos: PostgreSQL en contenedor (servicio 'postgres' del compose) ---
# El contenedor 'postgres' se inicializa con estas POSTGRES_*; n8n se conecta con las DB_POSTGRESDB_*.
# Usa el MISMO usuario/clave/db en ambos bloques.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambia-esta-clave-de-bd
POSTGRES_DB=n8n

DB_POSTGRESDB_HOST=postgres          # nombre del servicio en docker-compose (no cambiar)
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=cambia-esta-clave-de-bd

# --- AWS ---
AWS_REGION=us-east-2

# --- Grafana Cloud (referencia; el token real va en el credential store de n8n) ---
# GRAFANA_CLOUD_PROMETHEUS_URL=https://<stack>.grafana.net/api/prom/push
# GRAFANA_CLOUD_USER=<instance-id-numerico>
# GRAFANA_CLOUD_API_TOKEN=  <-- NO se versiona; se carga en n8n
