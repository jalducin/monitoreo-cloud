      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        460
      ],
      "parameters": {
        "jsCode": "const buckets = ['jalducin-portfolio-957266312835', 'metalshop-frontend-dev-957266312835', 'trackion-frontend-957266312835'];\nreturn buckets.map(b => ({ json: { bucket: b } }));\n"
      }
