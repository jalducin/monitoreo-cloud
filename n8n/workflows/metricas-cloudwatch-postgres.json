    {
      "id": "n3",
      "name": "Transformar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json;\nlet raw = body.data !== undefined ? body.data : body;\nlet obj = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst result = obj && obj.GetMetricStatisticsResponse && obj.GetMetricStatisticsResponse.GetMetricStatisticsResult;\nlet dps = (result && result.Datapoints) || [];\nconst arr = Array.isArray(dps) ? dps : [dps];\nlet latest = null;\nfor (const d of arr) {\n  if (d && d.Average != null && d.Timestamp != null) {\n    if (!latest || Number(d.Timestamp) > Number(latest.Timestamp)) latest = d;\n  }\n}\nif (!latest) return [];\nconst tsIso = new Date(Number(latest.Timestamp) * 1000).toISOString();\nconst val = Number(latest.Average);\nconst instance = 'i-0dbfa95b85e86f444';\nconst region = 'us-east-2';\nconst q = \"INSERT INTO metrics (metric_name, value, ts, instance_id, region) VALUES ('cpu_utilization', \" + val + \", '\" + tsIso + \"', '\" + instance + \"', '\" + region + \"')\";\nreturn [{ json: { query: q, value: val, ts: tsIso } }];\n"
      }
    },
