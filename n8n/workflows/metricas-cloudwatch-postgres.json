    {
      "id": "t1",
      "name": "Cron 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        420
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "l1",
      "name": "Lambdas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "jsCode": "const fns = ['metalshop-api-dev', 'trackion-develop-api', 'jalducin-assistant', 'trackion-develop-authorizer'];\nconst metrics = [\n  { metricName: 'Invocations', stat: 'Sum', label: 'lambda_invocations' },\n  { metricName: 'Errors', stat: 'Sum', label: 'lambda_errors' },\n  { metricName: 'Duration', stat: 'Average', label: 'lambda_duration_ms' }\n];\nconst out = [];\nfor (const fn of fns) for (const m of metrics) out.push({ json: { fn, metricName: m.metricName, stat: m.stat, label: m.label } });\nreturn out;\n"
      }
    },
    {
      "id": "l2",
      "name": "HTTP Lambda",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        200
      ],
      "credentials": {
        "aws": {
          "id": "awscloudwatchro1",
          "name": "AWS CloudWatch RO"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://monitoring.us-east-2.amazonaws.com/",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "aws",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "Action",
              "value": "GetMetricStatistics"
            },
            {
              "name": "Version",
              "value": "2010-08-01"
            },
            {
              "name": "Namespace",
              "value": "AWS/Lambda"
            },
            {
              "name": "MetricName",
              "value": "={{ $json.metricName }}"
            },
            {
              "name": "Dimensions.member.1.Name",
              "value": "FunctionName"
            },
            {
              "name": "Dimensions.member.1.Value",
              "value": "={{ $json.fn }}"
            },
            {
              "name": "StartTime",
              "value": "={{ $now.minus({ hours: 24 }).toUTC().toISO() }}"
            },
            {
              "name": "EndTime",
              "value": "={{ $now.toUTC().toISO() }}"
            },
            {
              "name": "Period",
              "value": "86400"
            },
            {
              "name": "Statistics.member.1",
              "value": "={{ $json.stat }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      }
    },
    {
      "id": "l3",
      "name": "TF Lambda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        200
      ],
      "parameters": {
        "jsCode": "const specs = $('Lambdas').all();\nconst items = $input.all();\nconst region = 'us-east-2';\nconst rows = [];\nfor (let i = 0; i < items.length; i++) {\n  const s = specs[i].json;\n  let raw = (items[i].json && items[i].json.data !== undefined) ? items[i].json.data : items[i].json;\n  let obj; try { obj = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch (e) { obj = {}; }\n  let dps = obj && obj.GetMetricStatisticsResponse && obj.GetMetricStatisticsResponse.GetMetricStatisticsResult\n    ? obj.GetMetricStatisticsResponse.GetMetricStatisticsResult.Datapoints : [];\n  const arr = Array.isArray(dps) ? dps : (dps ? [dps] : []);\n  let latest = null;\n  for (const d of arr) {\n    const val = d ? d[s.stat] : null;\n    if (val != null && d.Timestamp != null) {\n      if (!latest || Number(d.Timestamp) > Number(latest.Timestamp)) latest = { v: Number(val), ts: d.Timestamp };\n    }\n  }\n  const v = latest ? latest.v : 0;\n  const tsIso = latest ? new Date(Number(latest.ts) * 1000).toISOString() : new Date().toISOString();\n  const q = \"INSERT INTO metrics (metric_name, value, instance_id, region) VALUES ('\" + s.label + \"', \" + v + \", '\" + s.fn + \"', 'us-east-2')\";\n  rows.push({ json: { query: q } });\n}\nreturn rows;\n"
      }
    },
    {
      "id": "l4",
      "name": "Insert Lambda",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1160,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "postgresmetric01",
          "name": "Postgres metrics"
        }
      },
      "parameters": {
