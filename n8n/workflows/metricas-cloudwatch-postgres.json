        "jsCode": "return [\n  { json: { fn: 'metalshop-api-dev' } },\n  { json: { fn: 'trackion-develop-api' } },\n  { json: { fn: 'jalducin-assistant' } },\n  { json: { fn: 'trackion-develop-authorizer' } }\n];\n"
      }
    },
    {
      "id": "n3",
      "name": "Lambda Invocations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "https://monitoring.us-east-2.amazonaws.com/",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "aws",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "Action",
              "value": "GetMetricStatistics"
            },
            {
              "name": "Version",
              "value": "2010-08-01"
            },
            {
              "name": "Namespace",
              "value": "AWS/Lambda"
            },
            {
              "name": "MetricName",
              "value": "Invocations"
            },
            {
              "name": "Dimensions.member.1.Name",
              "value": "FunctionName"
            },
            {
              "name": "Dimensions.member.1.Value",
              "value": "={{ $json.fn }}"
            },
            {
              "name": "StartTime",
              "value": "={{ $now.minus({ hours: 24 }).toUTC().toISO() }}"
            },
            {
              "name": "EndTime",
              "value": "={{ $now.toUTC().toISO() }}"
            },
            {
              "name": "Period",
              "value": "86400"
            },
            {
              "name": "Statistics.member.1",
              "value": "Sum"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "credentials": {
        "aws": {
          "id": "awscloudwatchro1",
          "name": "AWS CloudWatch RO"
        }
      }
    },
    {
      "id": "n4",
      "name": "Transformar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        220
      ],
      "parameters": {
        "jsCode": "const funcs = $('Funciones').all();\nconst items = $input.all();\nconst region = 'us-east-2';\nconst rows = [];\nfor (let i = 0; i < items.length; i++) {\n  const fn = (funcs[i] && funcs[i].json && funcs[i].json.fn) ? funcs[i].json.fn : 'unknown';\n  let raw = (items[i].json && items[i].json.data !== undefined) ? items[i].json.data : items[i].json;\n  let obj;\n  try { obj = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch (e) { obj = {}; }\n  let dps = obj && obj.GetMetricStatisticsResponse && obj.GetMetricStatisticsResponse.GetMetricStatisticsResult\n    ? obj.GetMetricStatisticsResponse.GetMetricStatisticsResult.Datapoints : [];\n  const arr = Array.isArray(dps) ? dps : (dps ? [dps] : []);\n  let latest = null;\n  for (const d of arr) {\n    if (d && d.Sum != null && d.Timestamp != null) {\n      if (!latest || Number(d.Timestamp) > Number(latest.Timestamp)) latest = d;\n    }\n  }\n  const v = latest ? Number(latest.Sum) : 0;\n  const tsIso = latest ? new Date(Number(latest.Timestamp) * 1000).toISOString() : new Date().toISOString();\n  const q = \"INSERT INTO metrics (metric_name, value, ts, instance_id, region) VALUES ('lambda_invocations', \" + v + \", '\" + tsIso + \"', '\" + fn + \"', '\" + region + \"')\";\n  rows.push({ json: { query: q, fn: fn, value: v } });\n}\nreturn rows;\n"
      }
    },
    {
      "id": "n5",
      "name": "Insert metrics",
      "type": "n8n-nodes-base.postgres",
