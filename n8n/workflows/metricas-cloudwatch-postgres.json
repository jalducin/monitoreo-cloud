    {
      "id": "s3",
      "name": "TF S3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        460
      ],
      "parameters": {
        "jsCode": "const specs = $('Buckets').all();\nconst items = $input.all();\nconst region = 'us-east-2';\nconst rows = [];\nfor (let i = 0; i < items.length; i++) {\n  const bucket = specs[i].json.bucket;\n  let raw = (items[i].json && items[i].json.data !== undefined) ? items[i].json.data : items[i].json;\n  let obj; try { obj = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch (e) { obj = {}; }\n  let dps = obj && obj.GetMetricStatisticsResponse && obj.GetMetricStatisticsResponse.GetMetricStatisticsResult\n    ? obj.GetMetricStatisticsResponse.GetMetricStatisticsResult.Datapoints : [];\n  const arr = Array.isArray(dps) ? dps : (dps ? [dps] : []);\n  let latest = null;\n  for (const d of arr) {\n    if (d && d.Average != null && d.Timestamp != null) {\n      if (!latest || Number(d.Timestamp) > Number(latest.Timestamp)) latest = { v: Number(d.Average), ts: d.Timestamp };\n    }\n  }\n  const v = latest ? latest.v : 0;\n  const tsIso = latest ? new Date(Number(latest.ts) * 1000).toISOString() : new Date().toISOString();\n  const q = \"INSERT INTO metrics (metric_name, value, instance_id, region) VALUES ('s3_objects', \" + v + \", '\" + bucket + \"', 'us-east-2')\";\n  rows.push({ json: { query: q } });\n}\nreturn rows;\n"
      }
