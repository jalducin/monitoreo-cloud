    {
      "id": "c1",
      "name": "Lista contenedores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        240
      ],
      "parameters": {
        "method": "GET",
        "url": "http://docker-socket-proxy:2375/containers/json",
        "options": {}
      }
    },
    {
      "id": "c2",
      "name": "Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        240
      ],
      "parameters": {
        "method": "GET",
        "url": "=http://docker-socket-proxy:2375/containers/{{ $json.Id }}/stats?stream=false",
        "options": {}
      }
    },
    {
      "id": "c3",
      "name": "TF Contenedores",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        240
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst rows = [];\nfor (const it of items) {\n  const s = it.json;\n  if (!s || !s.name) continue;\n  const name = String(s.name).replace(/^\\//, '');\n  const memUsage = (s.memory_stats && s.memory_stats.usage) ? Number(s.memory_stats.usage) : 0;\n  const memMb = memUsage / 1048576;\n  let cpuPct = 0;\n  try {\n    const cd = s.cpu_stats.cpu_usage.total_usage - s.precpu_stats.cpu_usage.total_usage;\n    const sd = s.cpu_stats.system_cpu_usage - s.precpu_stats.system_cpu_usage;\n    let cpus = s.cpu_stats.online_cpus;\n    if (!cpus && s.cpu_stats.cpu_usage.percpu_usage) cpus = s.cpu_stats.cpu_usage.percpu_usage.length;\n    if (!cpus) cpus = 1;\n    if (sd > 0 && cd > 0) cpuPct = (cd / sd) * cpus * 100;\n  } catch (e) { cpuPct = 0; }\n  rows.push({ json: { query: \"INSERT INTO metrics (metric_name, value, instance_id, region) VALUES ('container_mem_mb', \" + memMb.toFixed(2) + \", '\" + name + \"', 'local')\" } });\n  rows.push({ json: { query: \"INSERT INTO metrics (metric_name, value, instance_id, region) VALUES ('container_cpu_pct', \" + cpuPct.toFixed(2) + \", '\" + name + \"', 'local')\" } });\n}\nreturn rows;\n"
      }
    },
    {
      "id": "c4",
      "name": "Insert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1160,
        240
      ],
      "credentials": {
        "postgres": {
          "id": "postgresmetric01",
          "name": "Postgres metrics"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.query }}",
        "options": {}
      }
    }
  ],
