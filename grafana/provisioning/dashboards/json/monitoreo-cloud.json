      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", value, metric_name AS metric FROM metrics WHERE $__timeFilter(ts) ORDER BY ts"
        }
      ]
    }
  ]
